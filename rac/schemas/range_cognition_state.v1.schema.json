{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RACRangeCognitionStateV1",
  "type": "object",
  "required": [
    "method",
    "question_type",
    "domain",
    "confidence_method",
    "scope",
    "factors",
    "evidence_packets",
    "checks",
    "hypotheses",
    "critic_findings",
    "fact_check",
    "belief_update",
    "final_report"
  ],
  "properties": {
    "method": {
      "const": "registered_range_evidence_rules_v1"
    },
    "question_type": {
      "enum": [
        "factual",
        "comparability_judgment"
      ]
    },
    "domain": {
      "const": "meituan_retail_ops"
    },
    "confidence_method": {
      "const": "not_estimated"
    },
    "scope": {
      "type": "object",
      "required": [
        "publication_id",
        "dataset_id",
        "store_ids",
        "fields",
        "windows"
      ],
      "properties": {
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "store_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window"
          }
        }
      },
      "additionalProperties": false
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      }
    },
    "evidence_packets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packet"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "critic_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "fact_check": {
      "type": "object",
      "required": [
        "status",
        "unresolved_check_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "pass_with_warnings"
          ]
        },
        "unresolved_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "belief_update": {
      "type": "object",
      "required": [
        "status",
        "confidence",
        "claim",
        "accepted_hypothesis_ids",
        "rejected_hypothesis_ids",
        "unresolved_hypothesis_ids",
        "validity_conditions"
      ],
      "properties": {
        "status": {
          "enum": [
            "active",
            "tentative"
          ]
        },
        "confidence": {
          "type": "null"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "accepted_hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validity_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "final_report": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "window": {
      "type": "object",
      "required": [
        "window_id",
        "period_start",
        "period_end",
        "days"
      ],
      "properties": {
        "window_id": {
          "enum": [
            "baseline",
            "current"
          ]
        },
        "period_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "period_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "missing_range": {
      "type": "object",
      "required": [
        "period_start",
        "period_end"
      ],
      "properties": {
        "period_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "period_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "requested_days",
        "covered_days",
        "missing_ranges",
        "null_source_records"
      ],
      "properties": {
        "requested_days": {
          "type": "integer",
          "minimum": 1
        },
        "covered_days": {
          "type": "integer",
          "minimum": 0
        },
        "missing_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/missing_range"
          }
        },
        "null_source_records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "source_record": {
      "type": "object",
      "required": [
        "record",
        "source"
      ],
      "properties": {
        "record": {
          "type": "object",
          "required": [
            "store_id",
            "period_start",
            "period_end",
            "period_month"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          }
        },
        "source": {
          "type": "object",
          "required": [
            "batch_id",
            "source_line_end",
            "binding_id",
            "source_system",
            "source_account_id",
            "source_store_id",
            "source_page",
            "extracted_at",
            "file_sha256",
            "mapping_version",
            "aggregation_scope",
            "aggregation_scope_sha256"
          ]
        }
      },
      "additionalProperties": false
    },
    "factor": {
      "type": "object",
      "required": [
        "factor_id",
        "priority",
        "evidence_status",
        "check_ids"
      ],
      "properties": {
        "factor_id": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "primary",
            "context"
          ]
        },
        "evidence_status": {
          "enum": [
            "supported",
            "partially_supported",
            "missing"
          ]
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "packet": {
      "type": "object",
      "required": [
        "evidence_id",
        "field",
        "store_id",
        "window_id",
        "period_start",
        "period_end",
        "value",
        "basis",
        "reason",
        "coverage",
        "ambiguities",
        "records",
        "overlapping_records"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "store_id": {
          "type": "string",
          "minLength": 1
        },
        "window_id": {
          "enum": [
            "baseline",
            "current"
          ]
        },
        "period_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "period_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "source_records",
            "reported_window",
            "sum_non_overlapping_days"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_record"
          }
        },
        "overlapping_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_record"
          }
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "check_id",
        "field",
        "operation",
        "evidence_ids",
        "status",
        "result",
        "difference",
        "reasons",
        "claim"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "record_values",
            "compare"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "supported",
            "unresolved"
          ]
        },
        "result": {
          "enum": [
            "recorded",
            "increased",
            "decreased",
            "unchanged",
            "unresolved"
          ]
        },
        "difference": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "hypothesis_id",
        "claim",
        "status",
        "confidence",
        "check_ids",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "contradicted",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "null"
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "issue",
        "evidence_ids"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
